    "@capawesome/capacitor-google-sign-in": "^0.1.2",
    "@tabler/icons-react": "3.44.0",
    "@vitejs/plugin-react": "6.0.2",
    "firebase": "^12.15.0",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-router": "^8.3.0",
    "typescript": "6.0.3",
    "vite": "8.0.16"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.4.1",
